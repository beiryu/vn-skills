{
  "name": "@vn-skills/core",
  "version": "0.7.0",
  "description": "Offline, dependency-free Vietnam business logic: VietQR, addresses (34 provinces), tax IDs, CCCD citizen IDs, phone numbers, public holidays and working days, money in words, number formatting, names, lunar calendar, e-invoice.",
  "keywords": [
    "vietnam",
    "vietnamese",
    "vietqr",
    "napas",
    "cccd",
    "ma-so-thue",
    "am-lich",
    "lunar",
    "hoa-don",
    "einvoice",
    "dia-chi",
    "address",
    "holidays",
    "agent-skills"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    }
  },
  "files": [
    "dist",
    "data/SOURCES.md",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beiryu/vn-skills.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22.12"
  }
}
