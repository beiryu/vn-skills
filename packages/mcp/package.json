{
  "name": "@vn-skills/mcp",
  "version": "0.5.0",
  "description": "MCP server exposing vn-skills tools (VietQR, addresses, tax IDs, CCCD citizen IDs, phone numbers, public holidays and working days, money in words, number formatting, names, lunar calendar, e-invoice) over stdio.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vietnam",
    "vietnamese",
    "vietqr",
    "napas",
    "cccd",
    "ma-so-thue",
    "am-lich",
    "lunar",
    "hoa-don",
    "einvoice",
    "dia-chi",
    "address",
    "holidays",
    "agent-skills",
    "claude",
    "cursor",
    "codex"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "vn-skills-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@vn-skills/cli": "workspace:*",
    "@vn-skills/core": "workspace:*",
    "qrcode": "^1.5.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beiryu/vn-skills.git",
    "directory": "packages/mcp"
  },
  "engines": {
    "node": ">=22.12"
  }
}
