{
  "name": "@vn-skills/cli",
  "version": "0.4.0",
  "description": "CLI used by the vn-skills Agent Skills: VietQR, addresses (34 provinces), tax IDs, CCCD citizen IDs, phone numbers, public holidays and working days, money in words, number formatting, names, lunar calendar, e-invoice.",
  "keywords": [
    "vietnam",
    "vietnamese",
    "vietqr",
    "napas",
    "cccd",
    "ma-so-thue",
    "am-lich",
    "lunar",
    "hoa-don",
    "einvoice",
    "dia-chi",
    "address",
    "holidays",
    "agent-skills",
    "claude",
    "cursor",
    "codex"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    "./decode": {
      "types": "./dist/decode.d.ts",
      "import": "./dist/decode.js"
    }
  },
  "bin": {
    "vn-skills": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@vn-skills/core": "workspace:*",
    "commander": "^15.0.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beiryu/vn-skills.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22.12"
  }
}
